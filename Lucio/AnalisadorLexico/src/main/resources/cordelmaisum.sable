Package cordelmaisum;
Helpers
    digito = ['0' .. '9'];
    letra_maiuscula = ['A' .. 'Z'];
    letra_minuscula = ['a' .. 'z'];
    underscore = '_';
    letra = letra_maiuscula | letra_minuscula;
    espaco = ' ';
    tab = 9;
    cr = 13;
    lf = 10;
    tudo = [0 .. 0xFFFF];

Tokens
     ja = 'Ja';
     ia = 'ia';
     esquecendo = 'esquecendo';
     tres_pontos = '...';
     preste = 'preste';
     atencao = 'atencao';
     por = 'por';
     favor = 'favor';
     diz_ser = 'diz ser';
     diz = 'diz';
     ser = 'ser';
     que_tem = 'que tem';
     como_valor = 'como valor';
     e_conn = 'e';
     com = 'Com';
     a_funcao = 'A funcao';
     arruma = 'arruma';
     ponto = '.';
     virgula = ',';
     se_cond = 'Se';
     para_ela = ', para ela,';
     para_voce_arranjar = 'para voce arranjar';
     voce_arranjar = 'voce arranjar';
     o_valor_de = 'o valor de';
     o_resultado_de = 'o resultado de';
     ela_ira_te_retornar = 'ela ira te retornar';
     ira = 'ira';
     seno = 'seno';
     cosseno = 'cosseno';
     tangente = 'tangente';
     potencia = 'potencia';
     logaritmo = 'logaritmo';
     retornar = 'retornar';
     te = 'te';
     marcador_inicio = 'Com sua licenca, por aqui vamos comecar!';
     sua = 'sua';
     licenca = 'licenca';
     aqui = 'aqui';
     vamos = 'vamos';
     comecar = 'comecar';
     exclamacao = 'exclamacao';
     tipo_num = 'um numero';
     tipo_bool = 'uma resposta';
     tipo_nada = 'um nada';
     numero = 'numero';
     resposta = 'resposta';
     nada = 'nada';
     se = 'se';
     entao = 'entao';
     senao = 'senao';
     uma_funcao = 'uma funcao';
     funcao = 'funcao';
     que_arruma = 'que arruma';
     que = 'que';
     em_troca_de = 'em troca de';
     em = 'em';
     troca = 'troca';
     ela = 'ela';
     de = 'de';
     sim = 'sim';
     nao = 'nao';
     tem = 'tem';
     valor = 'valor';
     para = 'para';
     voce = 'voce';
     arranjar = 'arranjar';
     como = 'como';
     o = 'o';
     resultado = 'resultado';
     soma = '+';
     sub = '-';
     mult = '*';
     div = '/';
     mod = '%';
     maior_igual = '>=';
     menor_igual = '<=';
     maior = '>';
     menor = '<';
     igual = '=';
     ou = 'ou';
     esq_par = '(';
     dir_par = ')';
     esq_col = '[';
     dir_col = ']';
     barra = '|';
     dois_pontos = ':';
     ponto_virgula = ';';
     uma_condicao_assim = 'uma condicao assim:';
     uma = 'uma';
     um = 'um';
     condicao = 'condicao';
     assim = 'assim';
     id = letra_maiuscula (letra | underscore)*;
     num_int = digito+;
     num_real = digito+ ',' digito+;
     comentario_linha = '#' [tudo - [cr + lf]]* (cr | lf | cr lf);
     comentario_bloco = '{' [tudo - '}']* '}';
     branco = (espaco | tab | cr | lf)+;

Ignored Tokens
    branco, comentario_linha, comentario_bloco;

Productions

    programa {-> programa} =
        {lista} dec_funcao*
        {-> New programa([dec_funcao.dec_funcao])};

    dec_funcao {-> dec_funcao} =
        [marcador]:marcador_inicio?
        a_funcao id arruma tipo [p1]:ponto
        se_cond [pe]:para_ela? parametros [v1]:virgula?
        [conector]:pva_prod [v2]:virgula
        [conector_valor]:o_valor_prod exp_retorno
        ela_ira_te_retornar [p2]:ponto
        secao_constantes?
        {-> New dec_funcao(marcador, id, tipo.tipo, [parametros.param_geral], exp_retorno.exp, [secao_constantes.dec_constante])};

    tipo {-> tipo} =
        {numero} tipo_num {-> New tipo.numero()} |
        {resposta} tipo_bool {-> New tipo.resposta()} |
        {nada} tipo_nada {-> New tipo.nada()};

    pva_prod =
        {completo} para_voce_arranjar |
        {parcial} voce_arranjar;

    o_valor_prod =
        {padrao} o_valor_de |
        {resultado} o_resultado_de;

    parametros {-> param_geral*} =
        {unico} param_geral
        {-> [param_geral.param_geral]} |
        {lista} parametro_multiplo
        {-> [parametro_multiplo.param_geral]};

    parametro_multiplo {-> param_geral*} =
        {duplo} [p1]:param_geral e_conn [p2]:param_geral
        {-> [p1.param_geral, p2.param_geral]} |
        {triplo_ou_mais} [p1]:param_geral virgula_parametro_lista e_conn [p2]:param_geral
        {-> [p1.param_geral, virgula_parametro_lista.param_geral, p2.param_geral]};

    virgula_parametro_lista {-> param_geral*} =
        {unico} virgula param_geral
        {-> [param_geral.param_geral]} |
        {recursivo} virgula_parametro_lista virgula param_geral
        {-> [virgula_parametro_lista.param_geral, param_geral.param_geral]};

    param_geral {-> param_geral} =
        {declaracao} tipo [nome]:id?
        {-> New param_geral.declaracao(tipo.tipo, nome)} |
        {assinatura} assinatura
        {-> assinatura.param_geral};

    assinatura {-> param_geral} =
        uma_funcao id esq_par que_arruma tipo em_troca_de parametros_assinatura dir_par
        {-> New param_geral.assinatura(id, tipo.tipo, [parametros_assinatura.param_geral])};

    parametros_assinatura {-> param_geral*} =
        {unico} param_geral
        {-> [param_geral.param_geral]} |
        {lista} parametro_assinatura_multiplo
        {-> [parametro_assinatura_multiplo.param_geral]};

    parametro_assinatura_multiplo {-> param_geral*} =
        {duplo} [p1]:param_geral e_conn [p2]:param_geral
        {-> [p1.param_geral, p2.param_geral]} |
        {triplo_ou_mais} [p1]:param_geral virgula_pa_lista e_conn [p2]:param_geral
        {-> [p1.param_geral, virgula_pa_lista.param_geral, p2.param_geral]};

    virgula_pa_lista {-> param_geral*} =
        {unico} virgula param_geral
        {-> [param_geral.param_geral]} |
        {recursivo} virgula_pa_lista virgula param_geral
        {-> [virgula_pa_lista.param_geral, param_geral.param_geral]};

    exp_retorno {-> exp} =
        {padrao} exp
        {-> exp.exp} |
        {condicao_ternaria} condicao_ternaria
        {-> condicao_ternaria.exp};

    condicao_ternaria {-> exp} =
        uma_condicao_assim se_ternario
        {-> se_ternario.exp};

    exp {-> exp} =
        {ternario} se_ternario
        {-> se_ternario.exp} |
        {disjuncao} exp_disjuncao
        {-> exp_disjuncao.exp};

    se_ternario {-> exp} =
        se esq_par [cond]:exp_disjuncao dir_par entao [verd]:exp_disjuncao senao [falso]:exp
        {-> New exp.ternario(cond.exp, verd.exp, falso.exp)};

    exp_disjuncao {-> exp} =
        {ou} exp_disjuncao ou exp_conjuncao
        {-> New exp.ou(exp_disjuncao.exp, exp_conjuncao.exp)} |
        {conjuncao} exp_conjuncao
        {-> exp_conjuncao.exp};

    exp_conjuncao {-> exp} =
        {e} exp_conjuncao e_conn exp_relacional
        {-> New exp.e(exp_conjuncao.exp, exp_relacional.exp)} |
        {relacional} exp_relacional
        {-> exp_relacional.exp};

    exp_relacional {-> exp} =
        {igual} exp_relacional igual exp_aritmetica
        {-> New exp.igual(exp_relacional.exp, exp_aritmetica.exp)} |
        {maior} exp_relacional maior exp_aritmetica
        {-> New exp.maior(exp_relacional.exp, exp_aritmetica.exp)} |
        {menor} exp_relacional menor exp_aritmetica
        {-> New exp.menor(exp_relacional.exp, exp_aritmetica.exp)} |
        {maior_igual} exp_relacional maior_igual exp_aritmetica
        {-> New exp.maior_igual(exp_relacional.exp, exp_aritmetica.exp)} |
        {menor_igual} exp_relacional menor_igual exp_aritmetica
        {-> New exp.menor_igual(exp_relacional.exp, exp_aritmetica.exp)} |
        {aritmetica} exp_aritmetica
        {-> exp_aritmetica.exp};

    exp_aritmetica {-> exp} =
        {soma} exp_aritmetica soma exp_fator
        {-> New exp.soma(exp_aritmetica.exp, exp_fator.exp)} |
        {sub} exp_aritmetica sub exp_fator
        {-> New exp.sub(exp_aritmetica.exp, exp_fator.exp)} |
        {fator} exp_fator
        {-> exp_fator.exp};

    exp_fator {-> exp} =
        {mult} exp_fator mult exp_unario_arit
        {-> New exp.mult(exp_fator.exp, exp_unario_arit.exp)} |
        {div} exp_fator div exp_unario_arit
        {-> New exp.div(exp_fator.exp, exp_unario_arit.exp)} |
        {mod} exp_fator mod exp_unario_arit
        {-> New exp.mod(exp_fator.exp, exp_unario_arit.exp)} |
        {unario} exp_unario_arit
        {-> exp_unario_arit.exp};

    exp_unario_arit {-> exp} =
        {menos} sub exp_unario_arit
        {-> New exp.menos(exp_unario_arit.exp)} |
        {unario_bool} exp_unario_bool
        {-> exp_unario_bool.exp};

    exp_unario_bool {-> exp} =
        {nao} nao exp_unario_bool
        {-> New exp.nao(exp_unario_bool.exp)} |
        {base} exp_base
        {-> exp_base.exp};

    exp_base {-> exp} =
        {int} num_int
        {-> New exp.int(num_int)} |
        {real} num_real
        {-> New exp.real(num_real)} |
        {sim} sim
        {-> New exp.sim()} |
        {nao_val} nao
        {-> New exp.nao_val()} |
        {id} id
        {-> New exp.id(id)} |
        {chamada} chamada
        {-> chamada.exp} |
        {par} esq_par exp dir_par
        {-> exp.exp};

    chamada {-> exp} =
        id esq_col lista_exp dir_col
        {-> New exp.chamada(id, [lista_exp.exp])};

    lista_exp {-> exp*} =
        {vazio}
        {-> []} |
        {elementos} lista_exp_elems
        {-> [lista_exp_elems.exp]};

    lista_exp_elems {-> exp*} =
        {unico} exp
        {-> [exp.exp]} |
        {varios} lista_exp_elems barra exp
        {-> [lista_exp_elems.exp, exp.exp]};

    secao_constantes {-> dec_constante*} =
        ja ia esquecendo tres_pontos preste atencao virgula por favor dois_pontos dec_constantes ponto
        {-> [dec_constantes.dec_constante]};

    dec_constantes {-> dec_constante*} =
        {unico} dec_constante
        {-> [dec_constante.dec_constante]} |
        {duplo} [d1]:dec_constante e_conn [d2]:dec_constante
        {-> [d1.dec_constante, d2.dec_constante]} |
        {triplo_ou_mais} [d1]:dec_constante virgula_const_lista e_conn [d2]:dec_constante
        {-> [d1.dec_constante, virgula_const_lista.dec_constante, d2.dec_constante]};

    virgula_const_lista {-> dec_constante*} =
        {unico} virgula dec_constante
        {-> [dec_constante.dec_constante]} |
        {recursivo} virgula_const_lista virgula dec_constante
        {-> [virgula_const_lista.dec_constante, dec_constante.dec_constante]};

    dec_constante {-> dec_constante} =
        id diz_ser tipo que_tem exp como_valor
        {-> New dec_constante(id, tipo.tipo, exp.exp)};

Abstract Syntax Tree

    programa = dec_funcao*;

    dec_funcao =
        [marcador]:marcador_inicio?
        [nome]:id
        [tipo_retorno]:tipo
        [params]:param_geral*
        [retorno]:exp
        [constantes]:dec_constante*;

    tipo =
        {numero} |
        {resposta} |
        {nada};

    param_geral =
        {declaracao} tipo [nome]:id? |
        {assinatura} [nome]:id [tipo_retorno]:tipo [params]:param_geral+;

    exp =
        {ternario} [cond]:exp [verd]:exp [falso]:exp |
        {ou} [esq]:exp [dir]:exp |
        {e} [esq]:exp [dir]:exp |
        {igual} [esq]:exp [dir]:exp |
        {maior} [esq]:exp [dir]:exp |
        {menor} [esq]:exp [dir]:exp |
        {maior_igual} [esq]:exp [dir]:exp |
        {menor_igual} [esq]:exp [dir]:exp |
        {soma} [esq]:exp [dir]:exp |
        {sub} [esq]:exp [dir]:exp |
        {mult} [esq]:exp [dir]:exp |
        {div} [esq]:exp [dir]:exp |
        {mod} [esq]:exp [dir]:exp |
        {menos} exp |
        {nao} exp |
        {int} num_int |
        {real} num_real |
        {sim} |
        {nao_val} |
        {id} id |
        {chamada} [nome]:id [args]:exp* |
        {bool} bool_val;

    bool_val =
         {sim} |
         {nao};


    dec_constante = [nome]:id tipo [valor]:exp;
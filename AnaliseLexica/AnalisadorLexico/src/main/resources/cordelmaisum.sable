Package cmu;

Helpers
    digito = ['0' .. '9'];
    letra_maiuscula = ['A' .. 'Z'];
    letra_minuscula = ['a' .. 'z'];
    underscore = '_';
    letra = letra_maiuscula | letra_minuscula;
    espaco = ' ';
    tab = 9;
    cr = 13;
    lf = 10;
    tudo = [0 .. 0xFFFF];

Tokens
    // Constantes (Highest Priority)
    ja = 'Ja';
    ia = 'ia';
    esquecendo = 'esquecendo';
    tres_pontos = '...';
    preste = 'preste';
    atencao = 'atencao';
    por = 'por';
    favor = 'favor';
    diz_ser = 'diz ser';
    que_tem = 'que tem';
    como_valor = 'como valor';
    e_conn = 'e';

    com = 'Com';
    a_funcao = 'A funcao';
    arruma = 'arruma';
    ponto = '.';
    virgula = ',';
    se_cond = 'Se';
    para_voce_arranjar = 'para voce arranjar';
    o_valor_de = 'o valor de';
    ela_ira_te_retornar = 'ela ira te retornar';
    marcador_inicio = 'Com sua licenca, por aqui vamos comecar!';
    tipo_num = 'um numero';
    tipo_bool = 'uma resposta';
    tipo_nada = 'um nada';
    se = 'se';
    entao = 'entao';
    senao = 'senao';
    uma_funcao = 'uma funcao';
    que_arruma = 'que arruma';
    em_troca_de = 'em troca de';
    sim = 'sim';
    nao = 'nao';
    soma = '+';
    sub = '-';
    mult = '*';
    div = '/';
    mod = '%';
    maior_igual = '>=';
    menor_igual = '<=';
    maior = '>';
    menor = '<';
    igual = '=';
    ou = 'ou';
    esq_par = '(';
    dir_par = ')';
    esq_col = '[';
    dir_col = ']';
    barra = '|';
    dois_pontos = ':';
    ponto_virgula = ';';
    uma_condicao_assim = 'uma condicao assim:';
    id = letra_maiuscula (letra | underscore)*;
    num_int = digito+;
    num_real = digito+ ',' digito+;
    comentario_linha = '#' [tudo - [cr + lf]]* (cr | lf | cr lf);
    comentario_bloco = '{' [tudo - '}']* '}';
    branco = (espaco | tab | cr | lf)+;

Ignored Tokens
    branco, comentario_linha, comentario_bloco;

Productions

    programa =
        {lista} dec_funcao+;

    dec_funcao =
        [marcador]:marcador_inicio?
        a_funcao id arruma tipo [p1]:ponto
        se_cond parametros [v1]:virgula
        para_voce_arranjar [v2]:virgula
        o_valor_de exp_retorno
        secao_constantes?
        ela_ira_te_retornar [p2]:ponto;

    tipo =
        {numero} tipo_num |
        {resposta} tipo_bool |
        {nada} tipo_nada;

    parametros =
        {unico} param_geral |
        {lista} parametro_multiplo;

    parametro_multiplo =
        {duplo} [p1]:param_geral e_conn [p2]:param_geral |
        {triplo_ou_mais} [p1]:param_geral virgula_parametro_lista e_conn [p2]:param_geral;

    virgula_parametro_lista =
        {unico} virgula param_geral |
        {recursivo} virgula_parametro_lista virgula param_geral;

    param_geral =
        {declaracao} tipo [nome]:id? |
        {assinatura} assinatura;

    assinatura =
        uma_funcao id esq_par que_arruma tipo em_troca_de parametros_assinatura dir_par;

    parametros_assinatura =
        {unico} param_geral |
        {lista} parametro_assinatura_multiplo;

    parametro_assinatura_multiplo =
        {duplo} [p1]:param_geral e_conn [p2]:param_geral |
        {triplo_ou_mais} [p1]:param_geral virgula_pa_lista e_conn [p2]:param_geral;

    virgula_pa_lista =
        {unico} virgula param_geral |
        {recursivo} virgula_pa_lista virgula param_geral;

    exp_retorno =
        {padrao} exp |
        {condicao_ternaria} condicao_ternaria;

    condicao_ternaria =
        uma_condicao_assim se_ternario;

    exp =
        {ternario} se_ternario |
        {disjuncao} exp_disjuncao;

    se_ternario =
        se esq_par [cond]:exp dir_par entao [verd]:exp senao [falso]:exp;

    exp_disjuncao =
        {ou} exp_disjuncao ou exp_conjuncao |
        {conjuncao} exp_conjuncao;

    exp_conjuncao =
        {e} exp_conjuncao e_conn exp_relacional |
        {relacional} exp_relacional;

    exp_relacional =
        {igual} exp_relacional igual exp_aritmetica |
        {maior} exp_relacional maior exp_aritmetica |
        {menor} exp_relacional menor exp_aritmetica |
        {maior_igual} exp_relacional maior_igual exp_aritmetica |
        {menor_igual} exp_relacional menor_igual exp_aritmetica |
        {aritmetica} exp_aritmetica;

    exp_aritmetica =
        {soma} exp_aritmetica soma exp_fator |
        {sub} exp_aritmetica sub exp_fator |
        {fator} exp_fator;

    exp_fator =
        {mult} exp_fator mult exp_unario |
        {div} exp_fator div exp_unario |
        {mod} exp_fator mod exp_unario |
        {unario} exp_unario;

    exp_unario =
        {menos} sub exp_unario |
        {nao} nao esq_par exp dir_par |
        {base} exp_base;

    exp_base =
        {int} num_int |
        {real} num_real |
        {sim} sim |
        {nao_val} nao |
        {id} id |
        {chamada} chamada |
        {par} esq_par exp dir_par;

    chamada = id esq_col lista_exp dir_col;

    lista_exp =
        {vazio} |
        {elementos} lista_exp_elems;

    lista_exp_elems =
        {unico} exp |
        {varios} lista_exp_elems barra exp;

    secao_constantes =
        ja ia esquecendo tres_pontos preste atencao virgula por favor dois_pontos dec_constantes ponto
        {-> New secao_constantes(dec_constantes)};

    dec_constantes =
        {unico} dec_constante |
        {duplo} [d1]:dec_constante e_conn [d2]:dec_constante |
        {triplo_ou_mais} [d1]:dec_constante virgula_const_lista e_conn [d2]:dec_constante;

    virgula_const_lista =
        {unico} virgula dec_constante |
        {recursivo} virgula_const_lista virgula dec_constante;

    dec_constante =
        id diz_ser tipo que_tem exp como_valor;

Abstract Syntax Tree

    programa = {lista} dec_funcao+;

    dec_funcao = [marcador]:marcador_inicio? a_funcao id arruma tipo [p1]:ponto se_cond parametros [v1]:virgula para_voce_arranjar [v2]:virgula o_valor_de exp_retorno secao_constantes? ela_ira_te_retornar [p2]:ponto;

    tipo = {numero} tipo_num | {resposta} tipo_bool | {nada} tipo_nada;
    parametros =
        {unico} param_geral |
        {lista} parametro_multiplo;

    param_geral = {declaracao} tipo [nome]:id? | {assinatura} assinatura;

    parametro_multiplo =
        {duplo} [p1]:param_geral e_conn [p2]:param_geral |
        {triplo_ou_mais} [p1]:param_geral virgula_parametro_lista e_conn [p2]:param_geral;

    virgula_parametro_lista = {unico} virgula param_geral | {recursivo} virgula_parametro_lista virgula param_geral;

    assinatura = uma_funcao id esq_par que_arruma tipo em_troca_de parametros_assinatura dir_par;

    parametros_assinatura =
        {unico} param_geral |
        {lista} parametro_assinatura_multiplo;

    parametro_assinatura_multiplo =
        {duplo} [p1]:param_geral e_conn [p2]:param_geral |
        {triplo_ou_mais} [p1]:param_geral virgula_pa_lista e_conn [p2]:param_geral;
    virgula_pa_lista = {unico} virgula param_geral | {recursivo} virgula_pa_lista virgula param_geral;

    exp_retorno = {padrao} exp | {condicao_ternaria} condicao_ternaria;
    condicao_ternaria = uma_condicao_assim se_ternario;

    exp = {ternario} se_ternario | {disjuncao} exp_disjuncao;
    se_ternario = se esq_par [cond]:exp dir_par entao [verd]:exp senao [falso]:exp;

    exp_disjuncao = {ou} exp_disjuncao ou exp_conjuncao | {conjuncao} exp_conjuncao;
    exp_conjuncao = {e} exp_conjuncao e_conn exp_relacional | {relacional} exp_relacional;

    exp_relacional =
        {igual} exp_relacional igual exp_aritmetica |
        {maior} exp_relacional maior exp_aritmetica |
        {menor} exp_relacional menor exp_aritmetica |
        {maior_igual} exp_relacional maior_igual exp_aritmetica |
        {menor_igual} exp_relacional menor_igual exp_aritmetica |
        {aritmetica} exp_aritmetica;

    exp_aritmetica =
        {soma} exp_aritmetica soma exp_fator |
        {sub} exp_aritmetica sub exp_fator |
        {fator} exp_fator;

    exp_fator =
        {mult} exp_fator mult exp_unario |
        {div} exp_fator div exp_unario |
        {mod} exp_fator mod exp_unario |
        {unario} exp_unario;

    exp_unario =
        {menos} sub exp_unario |
        {nao} nao esq_par exp dir_par |
        {base} exp_base;

    exp_base =
        {int} num_int |
        {real} num_real |
        {sim} sim |
        {nao_val} nao |
        {id} id |
        {chamada} chamada |
        {par} esq_par exp dir_par;

    chamada = id esq_col lista_exp dir_col;
    lista_exp = {vazio} | {elementos} lista_exp_elems;
    lista_exp_elems = {unico} exp | {varios} lista_exp_elems barra exp;

    secao_constantes = dec_constantes;
    dec_constantes =
        {unico} dec_constante |
        {duplo} [d1]:dec_constante e_conn [d2]:dec_constante |
        {triplo_ou_mais} [d1]:dec_constante virgula_const_lista e_conn [d2]:dec_constante;
    virgula_const_lista = {unico} virgula dec_constante | {recursivo} virgula_const_lista virgula dec_constante;
    dec_constante = id diz_ser tipo que_tem exp como_valor;